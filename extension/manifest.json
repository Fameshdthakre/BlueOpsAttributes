{
  "manifest_version": 3,
  "name": "BlueOps Enterprise Toolkit",
  "version": "2.0.0",
  "description": "Headless browser automation and scraping engine for BlueOps Features (A+, Image Auditor, Listing Auditor).",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest"
  ],

  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "*://blue-ops-attributes.vercel.app/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://blue-ops-attributes.vercel.app/*",
        "http://localhost/*"
      ],
      "js": ["content/blueops.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.amazon.com/dp/*",
        "*://*.amazon.co.uk/dp/*",
        "*://*.amazon.ca/dp/*"
      ],
      "js": ["content/amazon-pdp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://vendorcentral.amazon.com/*"
      ],
      "js": ["content/vendor-central.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://sellercentral.amazon.com/*"
      ],
      "js": ["content/seller-central.js"],
      "run_at": "document_idle"
    }
  ]
}
